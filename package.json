{
  "name": "pipeline-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "timeout 300 tsx --test tests/*.test.ts",
    "test:browser": "XBLOG_BROWSER_SMOKE=1 timeout 300 tsx --test tests/browser-smoke.test.ts",
    "xblog": "tsx --env-file=.env src/cli.ts run xblog --config config/xblog.json",
    "xblog:login": "tsx src/cli.ts login xblog --config config/xblog.json",
    "runs": "tsx src/cli.ts runs xblog",
    "setup:geckodriver": "tsx scripts/setup-geckodriver.ts"
  },
  "dependencies": {
    "webdriverio": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "geckodriver": "^8.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
