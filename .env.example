# Names of the environment variables the pipelines require. Values are never committed.
# Copy to .env and fill in. npm scripts load .env explicitly with --env-file=.env.

# Gateway root for the LLM chat profile referenced by config/llm.json, e.g. https://gateway.example/v1
LLM_BASE_URL=
# API key for the LLM chat profile referenced by config/llm.json.
LLM_API_KEY=

# Gateway root for the image profile referenced by config/llm.json.
IMAGE_BASE_URL=
# API key for the image profile referenced by config/llm.json.
IMAGE_API_KEY=
